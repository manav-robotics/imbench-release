              pos="0 0 0.345" rgba="0.50 0.33 0.18 1"
              group="0" friction="0.6 0.005 0.0001"/>

        <inertial pos="0 0 0.175" mass="3.0" diaginertia="0.08 0.08 0.03"/>
      </body>
      <site name="bottom_site" pos="0 0 0" size="0.001" rgba="0 0 0 0"/>
      <site name="top_site" pos="0 0 0.35" size="0.001" rgba="0 0 0 0"/>
      <site name="horizontal_radius_site" pos="0.10 0.10 0" size="0.001" rgba="0 0 0 0"/>
    </body>
  </worldbody>
</mujoco>
